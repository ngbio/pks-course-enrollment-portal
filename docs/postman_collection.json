{
  "info": {
    "name": "PKS Backend - Full API verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run on a disposable seeded database. Set demoPassword locally. Cookie jar handles login; no token is exported. Creates 3 students and one hidden enrolled course each run."
  },
  "variable": [
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "courseId",
      "value": ""
    },
    {
      "key": "emptyCourseId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Health') pm.collectionVariables.set('runId', pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          }
        ],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Response envelope', () => pm.expect(pm.response.json()).to.have.property('data'));",
              "pm.test('No password hash leaked', () => pm.expect(pm.response.text()).not.to.include('passwordHash'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Register Student A",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Origin",
            "value": "{{origin}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Postman Student\",\n  \"email\": \"a-{{runId}}@pks.test\",\n  \"password\": \"{{demoPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Response envelope', () => pm.expect(pm.response.json()).to.have.property('data'));",
              "pm.test('No password hash leaked', () => pm.expect(pm.response.text()).not.to.include('passwordHash'));"
            ]
          }
        }
      ]
    },
