NODE_ENV=development
PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pks
DB_PASSWORD="CHANGE_ME"
DB_NAME=pks_portal
# For Aiven, uncomment and set the CA path (Render: /etc/secrets/aiven-ca.pem).
# DB_SSL_CA=E:/PRIVATE/aiven-ca.pem
DB_CONNECTION_LIMIT=5
# Optional alternative: DATABASE_URL overrides all DB_* fields when set.
# DATABASE_URL=mysql://pks:CHANGE_ME@127.0.0.1:3306/pks_portal
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_SECONDS=7200
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000
TRUST_PROXY_HOPS=0
# Render + Cloudflare only: uncomment and set the same secret in the Worker.
# EDGE_PROXY_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters
# When EDGE_PROXY_SECRET is set, TRUST_PROXY_HOPS must be 1.
AUTH_WINDOW_MS=900000
LOGIN_IP_LIMIT=20
LOGIN_ACCOUNT_LIMIT=5
REGISTER_IP_LIMIT=5
SEED_DEMO_PASSWORD=PksDemo123!
# Used only by compose.yaml; DB_PASSWORD must match MYSQL_PASSWORD.
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
