NODE_ENV=development
PORT=4000
DATABASE_URL=mysql://pks:CHANGE_ME@127.0.0.1:3306/pks_portal
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_SECONDS=7200
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000
TRUST_PROXY_HOPS=0
AUTH_WINDOW_MS=900000
LOGIN_IP_LIMIT=20
LOGIN_ACCOUNT_LIMIT=5
REGISTER_IP_LIMIT=5
SEED_DEMO_PASSWORD=Choose-a-local-demo-password
# Used only by compose.yaml; DATABASE_URL password must match MYSQL_PASSWORD.
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
